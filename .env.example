# 공개 사이트 주소
NEXT_PUBLIC_SITE_URL=https://pi-coffee-roasters.vercel.app

# 기존 Supabase 공개 설정
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버에서만 사용하는 Supabase 키 (Vercel에 직접 입력, GitHub 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 결제위젯 연동 키 (Vercel에 직접 입력, GitHub 금지)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 확정된 기본 운영 정책
SHIPPING_FEE_KRW=3000
ALLOW_GUEST_CHECKOUT=false
ALLOW_DELIVERY_MEMO=true

# 사장님 확인 후 입력: 무료배송이 없으면 NONE, 있으면 기준 금액(원)
FREE_SHIPPING_THRESHOLD_KRW=

# 모든 테스트가 끝나기 전까지 false 유지
CHECKOUT_ENABLED=false
# 라이브 키 사용을 별도로 잠그는 최종 안전장치
ALLOW_LIVE_PAYMENTS=false
